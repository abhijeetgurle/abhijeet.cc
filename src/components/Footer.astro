---
import { SITE } from '../consts';
---

<footer class="container">
  <span>© {new Date().getFullYear()} {SITE.author}</span>
  <span class="links">
    <a href={SITE.socials.github}>GitHub</a>
    <a href={SITE.socials.twitter}>X</a>
    <a href={SITE.socials.linkedin}>LinkedIn</a>
  </span>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 6rem;
    padding-bottom: 3rem;
    font-size: 0.875rem;
    color: var(--faint);
  }
  .links { display: flex; gap: 1.25rem; }
  a:hover { color: var(--fg); }
</style>
