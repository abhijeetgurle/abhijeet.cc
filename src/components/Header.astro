---
import { NAV, SITE } from '../consts';
const path = Astro.url.pathname;
---

<header class="container">
  <a href="/" class="brand">{SITE.title}</a>
  <nav>
    {NAV.map(({ href, label }) => (
      <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
    ))}
    <button id="theme-toggle" aria-label="Toggle dark mode" title="Toggle theme">◐</button>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }
  .brand { font-weight: 500; }
  nav { display: flex; align-items: center; gap: 1.5rem; font-size: 0.9375rem; }
  nav a { color: var(--muted); }
  nav a:hover, nav a[aria-current='page'] { color: var(--fg); }
  button {
    background: none;
    border: 0;
    color: var(--muted);
    font-size: 1rem;
    cursor: pointer;
    padding: 0;
  }
  button:hover { color: var(--fg); }

  @media (max-width: 480px) {
    header { padding-bottom: 3.5rem; }
    nav { gap: 1rem; font-size: 0.875rem; }
  }
</style>
