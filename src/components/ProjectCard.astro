---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { title, description, stack, repo, demo } = Astro.props.project.data;
---

<article>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="meta small muted">
    {stack.length > 0 && <span>{stack.join(' · ')}</span>}
    <span class="links">
      {repo && <a href={repo}>Code ↗</a>}
      {demo && <a href={demo}>Live ↗</a>}
    </span>
  </div>
</article>

<style>
  article {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  h3 { margin: 0 0 0.25rem; }
  p { margin: 0 0 0.75rem; }
  .meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; }
  .links { display: flex; gap: 0.75rem; }
</style>
