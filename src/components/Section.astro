---
interface Props {
  title: string;
  more?: { href: string; label: string };
}
const { title, more } = Astro.props;
---

<section>
  <h2>{title}</h2>
  <div>
    <slot />
    {more && <a class="more" href={more.href}>{more.label} →</a>}
  </div>
</section>

<style>
  section { margin-bottom: 4.5rem; }
  h2 {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 1.25rem;
  }
  .more { display: inline-block; margin-top: 1.5rem; font-size: 0.875rem; color: var(--muted); }
  .more:hover { color: var(--accent); }

  @media (min-width: 720px) {
    section { display: grid; grid-template-columns: 9rem 1fr; gap: 2rem; }
    h2 { margin: 0; line-height: 1.7rem; }
  }
</style>
