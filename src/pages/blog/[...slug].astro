---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, readingTime } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags, draft } = post.data;
---

<Base title={title} description={description} type="article">
  <article>
    <header class="page-header">
      <h1>{title}</h1>
      <p class="small">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span> · Updated {formatDate(updated)}</span>}
        <span> · {readingTime(post.body)}</span>
        {draft && <span> · <strong>Draft</strong></span>}
      </p>
      {tags.length > 0 && (
        <p class="tags">{tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>{tag}</a>)}</p>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="back small"><a href="/blog">← All posts</a></p>
  </article>
</Base>

<style>
  .back { margin-top: 4rem; color: var(--muted); }
</style>
