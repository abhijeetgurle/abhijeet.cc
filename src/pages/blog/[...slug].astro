---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, readingTime } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags, draft } = post.data;
---

<Base title={title} description={description} type="article">
  <article>
    <header>
      <h1>{title}</h1>
      <p class="muted small">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <> · Updated {formatDate(updated)}</>}
        · {readingTime(post.body)}
        {draft && <> · <strong>Draft</strong></>}
      </p>
      {tags.length > 0 && <p>{tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>{tag}</a>)}</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
