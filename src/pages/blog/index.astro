---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../utils';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base title="Blog" description="All posts">
  <header class="page-header">
    <h1>Blog</h1>
    <p>Notes on software, side projects, and things I learn along the way.</p>
    {tags.length > 0 && (
      <p class="tags">{tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>{tag}</a>)}</p>
    )}
  </header>
  <PostList posts={posts} />
</Base>
