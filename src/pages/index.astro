---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPosts, getProjects } from '../utils';
import { SITE } from '../consts';

const posts = (await getPosts()).slice(0, 5);
const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
---

<Base>
  <section class="intro">
    <h1>Hi, I'm Abhijeet.</h1>
    <p class="muted">
      I'm a software engineer at <a href="https://www.akto.io">Akto</a>, working mostly on backend
      systems. I like learning things by building them from scratch, and lately that has meant
      building with LLMs. This is where I keep my writing and side projects.
    </p>
    <p class="small social">
      <a href={SITE.socials.github}>GitHub</a>
      <a href={SITE.socials.linkedin}>LinkedIn</a>
      <a href={SITE.socials.twitter}>X</a>
      <a href="/about">More about me →</a>
    </p>
  </section>

  <section>
    <h2>Recent writing</h2>
    <PostList posts={posts} />
    <p class="small"><a href="/blog">All posts →</a></p>
  </section>

  {featured.length > 0 && (
    <section>
      <h2>Projects</h2>
      <div class="grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
      <p class="small"><a href="/projects">All projects →</a></p>
    </section>
  )}
</Base>

<style>
  .intro p { font-size: 1.15rem; margin: 0; }
  .intro .social { display: flex; gap: 1rem; margin-top: 1rem; font-size: 0.9rem; }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
</style>
