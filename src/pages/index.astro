---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import { getPosts, getProjects } from '../utils';

const posts = (await getPosts()).slice(0, 5);
const featured = (await getProjects()).filter((p) => p.data.featured);
---

<Base>
  <section class="hero">
    <h1>Abhijeet Gurle</h1>
    <p class="role">Software engineer</p>
    <p class="bio">
      I work mostly on backend systems and like learning things by building them from scratch.
      Lately that has meant building with LLMs.
    </p>
  </section>

  <Section title="Writing" more={posts.length > 0 ? { href: '/blog', label: 'All posts' } : undefined}>
    <PostList posts={posts} />
  </Section>

  <Section title="Projects" more={{ href: '/projects', label: 'All projects' }}>
    <ProjectList projects={featured} />
  </Section>

</Base>

<style>
  .hero { padding-bottom: 3rem; }
  .role { margin: 0.25rem 0 0; color: var(--muted); }
  .bio { margin: 1.5rem 0 0; max-width: 36rem; }
</style>
