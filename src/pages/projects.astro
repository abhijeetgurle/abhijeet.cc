---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../utils';

const projects = await getProjects();
---

<Base title="Projects" description="Things I've built">
  <h1>Projects</h1>
  <p class="muted">Things I've built, am building, or have abandoned with dignity.</p>
  <div class="grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</Base>

<style>
  .grid { display: grid; gap: 1rem; margin-top: 2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
</style>
